{
  "apiVersion": "forge/v1",
  "kind": "Workflow",
  "metadata": {
    "description": "Forge supported task-takeover golden path",
    "name": "task_takeover",
    "revision": 6
  },
  "spec": {
    "entry": "triage_check",
    "includes": [
      {
        "exits": {
          "blocked": "escalate_blocked",
          "review": "human_review_gate",
          "setup": "setup_workspace"
        },
        "name": "github_pr_review",
        "source": "builtin"
      }
    ],
    "resume": {
      "fromRevisions": {}
    },
    "state": "task_takeover",
    "steps": {
      "answer_question": {
        "branches": {
          "task_plan_approval_gate": "task_plan_approval_gate"
        },
        "dynamicRoute": false,
        "route": "route_after_answer"
      },
      "complete_task_takeover": {
        "branches": {},
        "dynamicRoute": false,
        "next": "__end__"
      },
      "escalate_blocked": {
        "branches": {},
        "dynamicRoute": false,
        "next": "__end__"
      },
      "generate_plan": {
        "branches": {
          "escalate_blocked": "escalate_blocked",
          "generate_plan": "generate_plan",
          "task_plan_approval_gate": "task_plan_approval_gate"
        },
        "dynamicRoute": false,
        "retryBound": 3,
        "route": "route_after_generate_plan"
      },
      "human_review_gate": {
        "branches": {
          "__end__": "__end__",
          "ci_evaluator": "ci_evaluator",
          "complete_task_takeover": "complete_task_takeover",
          "complete_tasks": "complete_task_takeover",
          "implement_review": "implement_review"
        },
        "dynamicRoute": false,
        "route": "route_human_review_task_takeover"
      },
      "implement_work": {
        "branches": {
          "escalate_blocked": "escalate_blocked",
          "implement_work": "implement_work",
          "run_qualitative_review": "run_qualitative_review"
        },
        "dynamicRoute": false,
        "retryBound": 100,
        "route": "route_after_execution"
      },
      "run_qualitative_review": {
        "branches": {
          "create_pr": "create_pr",
          "escalate_blocked": "escalate_blocked",
          "implement_work": "implement_work",
          "run_qualitative_review": "run_qualitative_review"
        },
        "dynamicRoute": false,
        "retryBound": 3,
        "route": "route_after_qualitative_review"
      },
      "setup_workspace": {
        "branches": {
          "escalate_blocked": "escalate_blocked",
          "implement_work": "implement_work"
        },
        "dynamicRoute": false,
        "route": "route_after_workspace_setup"
      },
      "task_plan_approval_gate": {
        "branches": {
          "__end__": "__end__",
          "answer_question": "answer_question",
          "regenerate_plan": "generate_plan",
          "setup_workspace": "setup_workspace"
        },
        "dynamicRoute": false,
        "route": "route_task_plan_approval"
      },
      "triage_check": {
        "branches": {
          "escalate_blocked": "escalate_blocked",
          "generate_plan": "generate_plan",
          "triage_check": "triage_check",
          "triage_gate": "triage_gate"
        },
        "dynamicRoute": false,
        "retryBound": 3,
        "route": "route_after_triage_check"
      },
      "triage_gate": {
        "branches": {
          "__end__": "__end__",
          "triage_check": "triage_check"
        },
        "dynamicRoute": false,
        "route": "route_triage_gate"
      }
    }
  }
}
